# Frontend (all optional: without them the desk runs on seed leases and still reads Arbitrum Sepolia live)
# Every key below is read in lib/config.ts and nowhere else (NEXT_PUBLIC_BRAND_FILES: lib/brand-files.ts).

# DepositVault address, written by the farm's Kontrat deploy step (printed by contracts/script/Deploy.s.sol).
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Chain id of the deployment, written by the deploy step. 421614 = Arbitrum Sepolia (the default).
NEXT_PUBLIC_CHAIN_ID=421614
# Optional RPC override. Defaults to the public https://sepolia-rollup.arbitrum.io/rpc (no key).
# An Alchemy or Infura Arbitrum Sepolia URL works too (create one in their dashboards).
NEXT_PUBLIC_RPC_URL=
# Where server-side lease reads come from: "fake" (seed leases, the default) or "real" (reads DepositVault over the public RPC).
ADAPTER_MODE=fake
# Set by next.config.ts at build time from public/brand/*.png; leave empty.
NEXT_PUBLIC_BRAND_FILES=

# Contracts (read by forge scripts in contracts/script, never by the Next.js app)

# Testnet deployer key from the farm wallet. Fund it with Arbitrum Sepolia ETH from a faucet. Never commit it.
PRIVATE_KEY=
# Real Paxos USDG address on the target chain, read only by contracts/script/DeployWithUsdg.s.sol.
USDG_ADDRESS=
# Vault address for contracts/script/Smoke.s.sol, set by the deploy step (same value as NEXT_PUBLIC_CONTRACT_ADDRESS).
DEPLOYED_CONTRACT=
