# Frontend (all optional: without them the desk runs on seed leases and still reads Arbitrum Sepolia live)

# DepositVault address, printed by contracts/script/Deploy.s.sol after deploy.
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Chain id of the deployment. 421614 = Arbitrum Sepolia.
NEXT_PUBLIC_CHAIN_ID=421614
# Optional RPC override. Defaults to the public https://sepolia-rollup.arbitrum.io/rpc (no key).
# An Alchemy or Infura Arbitrum Sepolia URL works too (create one in their dashboards).
NEXT_PUBLIC_RPC_URL=
# Where server-side lease reads come from: "fake" (seed leases, the default) or "real" (chain reads, Phase 2).
ADAPTER_MODE=fake
# Set by next.config.ts at build time from public/brand/*.png; leave empty.
NEXT_PUBLIC_BRAND_FILES=

# Contracts (read by forge scripts in contracts/script, never by the Next.js app)

# Testnet deployer key. Fund it with Arbitrum Sepolia ETH from a faucet (Alchemy or QuickNode faucets).
PRIVATE_KEY=
# Optional: real Paxos USDG address on the target chain. Leave empty to deploy MockUSDG.
USDG_ADDRESS=
# Vault address for contracts/script/Smoke.s.sol (same value as NEXT_PUBLIC_CONTRACT_ADDRESS).
DEPLOYED_CONTRACT=
